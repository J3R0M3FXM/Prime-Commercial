# Required to validate Telegram initData
TELEGRAM_BOT_TOKEN=
# Required to sign cryptotokens
SESSION_SECRET=
# Required to access Admin Panel
ADMIN_ACCESS_CODE=
# Telegram User ID that automatically grants Admin access without code (default: 1085949511)
ADMIN_TELEGRAM_USER_ID=
# Optional Telegram Channel or Chat ID to store uploaded gallery videos (e.g. @channel_name or chat id)
TELEGRAM_STORAGE_CHAT_ID=
# Fingerprinting services
IPLOCATE_API_KEY=
GEOAPIFY_API_KEY=

# AI Model & OCR Configuration
GEMINI_API_KEY=
OPENAI_API_KEY=

# Maya Checkout
# Must match the environment of the Maya public/secret API keys configured in payment methods.
MAYA_ENVIRONMENT=production

# Supabase Configuration (Database & Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase config (Optional / Fallback)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=
