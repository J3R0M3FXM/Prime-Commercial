{
  "name": "prime-auth",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-15",
  "routes": [{ "pattern": "auth.codespacelabs.online/*", "zone_name": "codespacelabs.online" }],
  "kv_namespaces": [{ "binding": "AUTH_CODES", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "vars": {
    "TELEGRAM_BOT_USERNAME": "primenetworkphbot",
    "AUTH_CALLBACK_URL": "https://auth.codespacelabs.online/callback",
    "NATIVE_CALLBACK_URL": "prime://auth/callback"
  }
}
