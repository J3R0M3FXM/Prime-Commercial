# Replace with the real hostname before enabling Caddy.
# Caddy obtains and renews HTTPS certificates automatically when DNS points here
# and inbound TCP 80/443 are reachable.
prime.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:3000
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
