{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Admin configuration",
      "type": "object",
      "properties": {
        "accessCode": { "type": "string", "description": "Admin Access Code" }
      },
      "required": ["accessCode"]
    },
    "Product": {
      "title": "Product",
      "description": "Product in the catalog",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Product Name" },
        "price": { "type": "number", "description": "Price" },
        "imageUrl": { "type": "string", "description": "Image URL" },
        "description": { "type": "string", "description": "Description" },
        "category": { "type": "string", "description": "Category" },
        "stock": { "type": "number", "description": "Available stock quantity" },
        "bundleConfig": { "type": "object", "description": "Configuration for bundles/discounts" }
      },
      "required": ["name", "price", "stock"]
    },
    "User": {
      "title": "User",
      "description": "Telegram user profile and PRIME mapping",
      "type": "object",
      "properties": {
        "tgUserId": { "type": "string", "description": "Telegram User ID" },
        "tgName": { "type": "string", "description": "Telegram Name" },
        "tgUsername": { "type": "string", "description": "Telegram Handle" },
        "phoneNumber": { "type": "string", "description": "Phone Number" },
        "primeMemberId": { "type": "string", "description": "12-char Alphanumeric Member ID" },
        "groups": { "type": "array", "description": "List of group IDs" },
        "channels": { "type": "array", "description": "List of channel IDs" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tgUserId", "primeMemberId"]
    },
    "Fingerprint": {
      "title": "Fingerprint",
      "description": "Device and session fingerprint snapshot",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "enrollmentDate": { "type": "string", "format": "date-time" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "deviceId": { "type": "string" },
        "appId": { "type": "string" },
        "browser": { "type": "string" },
        "platform": { "type": "string" },
        "screenResolution": { "type": "string" },
        "timezone": { "type": "string" },
        "graphics": { "type": "string" },
        "ipEnrollment": { "type": "string" },
        "ipSession": { "type": "string" },
        "isp": { "type": "string" },
        "vpnDetected": { "type": "boolean" },
        "location": { "type": "object" }
      },
      "required": ["userId", "deviceId"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order record",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "primeMemberId": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "paymentMethodId": { "type": "string" },
        "paymentMethodName": { "type": "string" },
        "paymentProofImage": { "type": "string" },
        "paymentStatus": { "type": "string" }
      },
      "required": ["orderNumber", "customerId", "totalAmount"]
    },
    "PaymentMethod": {
      "title": "PaymentMethod",
      "description": "Payment method configuration",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "paymentType": { "type": "string", "enum": ["qr_code", "api", "crypto", "manual_transfer"] },
        "qrCodeImage": { "type": "string" },
        "webhookUrl": { "type": "string" },
        "publicKey": { "type": "string" },
        "secretKey": { "type": "string" },
        "walletAddress": { "type": "string" },
        "accountName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "sortOrder": { "type": "number", "description": "Manual sort sequence index" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "paymentType", "isActive"]
    },
    "Promo": {
      "title": "Promo",
      "description": "Voucher or Promo Code configuration",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "discountType": { "type": "string", "enum": ["fixed", "percentage", "free_shipping"] },
        "discountValue": { "type": "number" },
        "maxDiscountAmount": { "type": "number" },
        "minSpend": { "type": "number" },
        "totalUsageLimit": { "type": "number" },
        "usageCount": { "type": "number" },
        "usageLimitPerCustomer": { "type": "number" },
        "isActive": { "type": "boolean" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["code", "discountType", "discountValue", "isActive"]
    },
    "PromoRedemption": {
      "title": "PromoRedemption",
      "description": "Redemption log for fraud detection",
      "type": "object",
      "properties": {
        "promoCode": { "type": "string" },
        "promoId": { "type": "string" },
        "customerId": { "type": "string" },
        "primeMemberId": { "type": "string" },
        "orderId": { "type": "string" },
        "deviceId": { "type": "string" },
        "hardwareId": { "type": "string" },
        "discountAmount": { "type": "number" },
        "usedAt": { "type": "string" }
      },
      "required": ["promoCode", "orderId", "usedAt"]
    },
    "PointTransaction": {
      "title": "PointTransaction",
      "description": "Audit record of points and store credits activity",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "orderId": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "type", "amount", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Admin configuration"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product catalog"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/users/{userId}/fingerprints/{fingerprintId}": {
      "schema": "Fingerprint",
      "description": "User specific fingerprints"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders collection"
    },
    "/payment_methods/{methodId}": {
      "schema": "PaymentMethod",
      "description": "Configured payment methods"
    },
    "/promos/{promoId}": {
      "schema": "Promo",
      "description": "Store promo codes and vouchers"
    },
    "/promo_redemptions/{redemptionId}": {
      "schema": "PromoRedemption",
      "description": "Promo redemptions and device fraud log"
    },
    "/point_transactions/{txId}": {
      "schema": "PointTransaction",
      "description": "Points and store credits transactions"
    }
  }
}
