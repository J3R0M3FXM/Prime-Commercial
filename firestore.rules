rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true; // Allow API route to create/update user profiles
      
      match /fingerprints/{fingerprintId} {
        allow read, write: if true; // Allow API route to save fingerprints
      }
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }
    
    match /payment_methods/{methodId} {
      allow read, write: if true;
    }
    
    match /warehouses/{warehouseId} {
      allow read: if true;
      allow write: if true; // In production, this should be isAdmin(), but keeping consistent with open API approach for now
    }

    match /couriers/{courierId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /charges/{chargeId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /admins/{adminId} {
      allow read: if false; // Admin code check should be server-side
      allow write: if false;
    }
  }
}
